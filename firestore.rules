rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()    { return isLoggedIn() && myRole() == 'admin';    }
    function isDriver()   { return isLoggedIn() && myRole() == 'driver';   }
    function isCustomer() { return isLoggedIn() && myRole() == 'customer'; }

    // ── USERS ─────────────────────────────────────────────────────────────
    // Any logged-in user can read profiles (needed for driver name lookups)
    // Users create/update their own profile; admin can create/update anyone
    // (needed so Admin can create Driver and Branch Staff accounts)
    match /users/{userId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── ORDERS ────────────────────────────────────────────────────────────
    // All logged-in users can read orders
    // Customers create; admins and drivers update
    match /orders/{orderId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isAdmin();
    }

    // ── BRANCHES ──────────────────────────────────────────────────────────
    // All logged-in users read; only admin writes
    match /branches/{branchId} {
      allow read:   if isLoggedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────
    // Users only read/update their own notifications
    // Any logged-in user can create (needed to notify across roles)
    match /notifications/{notifId} {
      allow read:   if isLoggedIn() && resource.data.uid == request.auth.uid;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    // ── CONTACT MESSAGES ─────────────────────────────────────────────────
    // Anyone (even logged-out visitors) can submit a contact message.
    // Only admins can read them back.
    match /messages/{messageId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
